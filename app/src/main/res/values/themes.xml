<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EverythingBIM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- <item name="android:fontFamily">@font/roboto_regular</item>-->
    </style>

    <style name="Theme.EverythingBIM" parent="Base.Theme.EverythingBIM" />

    <!-- ~~~~~BUTTON STYLES~~~~~  -->

    <!-- Yellow Bttn Style -->
    <style name="bttn_style_yllw">
        <item name="android:background">@drawable/bttn_bg_yllw</item>
        <item name="android:fontFamily">@font/roboto_extrabold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- ~~~~~EDITTEXT STYLES~~~~~  -->

    <!-- EditText Field Style -->
    <style name="et_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:textSize">15dp</item>
        <item name="android:background">@drawable/bg_grey</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Email Verification EditText Field Style -->
    <style name="email_vf_et_style">
        <item name="android:fontFamily">@font/roboto_extrabold</item>
        <item name="android:textSize">15dp</item>
        <item name="android:background">@drawable/bg_grey</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
    </style>


    <!-- ~~~~~TEXT STYLES~~~~~  -->

    <!-- Heading Text Style (For Dark BGs) -->
    <style name="heading_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Sub-heading Text Style (For Dark BGs) -->
    <style name="subheading_txt_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Info Text Style -->
    <style name="info_txt_style">
        <item name="android:fontFamily">@font/roboto_light</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/dark_grey</item>
    </style>
</resources>