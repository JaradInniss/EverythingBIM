<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EverythingBIM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- <item name="android:fontFamily">@font/roboto_regular</item>-->
    </style>

    <style name="Theme.EverythingBIM" parent="Base.Theme.EverythingBIM" />

    <!-- ~~~~~BUTTON STYLES~~~~~  -->

    <!-- Yellow Bttn Style -->
    <style name="rectangle_bttn_gold">
        <item name="android:background">@drawable/bg_rectangle_gold</item>
        <item name="android:fontFamily">@font/roboto_extrabold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- ~~~~~EDITTEXT STYLES~~~~~  -->

    <!-- EditText Field Style -->
    <style name="et_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_rectangle_pale_slate</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Email Verification EditText Field Style -->
    <style name="email_vf_et_style">
        <item name="android:fontFamily">@font/roboto_extrabold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_rectangle_white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Materials Component TextInputLayout Style -->
    <style name="auth_txtInputLayout_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:background">@drawable/bg_rectangle_white</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="android:padding">5dp</item>
        <item name="android:textColorHint">@color/dark</item>
        <item name="hintTextColor">@color/black</item>
        <item name="boxStrokeColor">@color/black</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="txtInputLayout_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:background">@drawable/bg_rectangle_white</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="android:padding">5dp</item>
        <item name="android:textColorHint">@color/dark</item>
        <item name="hintTextColor">@color/black</item>
        <item name="boxStrokeColor">@color/black</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Materials Component TextInputEditText Style -->
    <style name="txtInputEditText_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- File Upload Field Style -->
    <style name="file_upload_field_style">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:background">@drawable/bg_rectangle_white</item>
    </style>

    <!-- File Upload Bttn Style -->
    <style name="file_upload_bttn_style">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:src">@drawable/ic_paperclip</item>
        <item name="android:background">@drawable/bg_border_rectangle_alice_blue</item>
    </style>


    <!-- ~~~~~TEXT STYLES~~~~~  -->

    <!-- Heading Text Style (For Dark BGs) -->
    <style name="heading_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Sub-heading Text Style (For Dark BGs) -->
    <style name="subheading_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- === Normal Text Styles === -->

    <!-- Grey Medium Text Style -->
    <style name="grey_medium_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dim_grey</item>
    </style>

    <!-- Grey Small Text Style -->
    <style name="grey_small_txt_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/dim_grey</item>
    </style>

    <!-- Black Medium Text Style -->
    <style name="black_medium_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Black Small Text Style -->
    <style name="black_small_txt_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- White Medium Text Style -->
    <style name="white_medium_txt_style">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- White Small Text Style -->
    <style name="white_small_txt_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Info Text Style -->
    <style name="info_txt_style">
        <item name="android:fontFamily">@font/roboto_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dim_grey</item>
    </style>
</resources>