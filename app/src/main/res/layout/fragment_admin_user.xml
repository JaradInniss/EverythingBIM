<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- User Type Selection -->
        <LinearLayout
            android:id="@+id/user_type_selection"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:padding="5dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_rectangle_periwinkle"
            android:layout_above="@id/reg_form_viewflipper"
            android:elevation="20dp">

            <LinearLayout
                android:id="@+id/btn_general_users"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/general_user_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/dark" />

                <TextView
                    android:id="@+id/general_user_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="General"
                    android:textColor="@color/dark"
                    android:fontFamily="@font/roboto_medium"/>
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_blue"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>

            <LinearLayout
                android:id="@+id/btn_business_users"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/business_user_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_storefront"
                    app:tint="@color/dark" />

                <TextView
                    android:id="@+id/business_user_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Business"
                    android:textColor="@color/dark"
                    android:fontFamily="@font/roboto_medium"/>

            </LinearLayout>

        </LinearLayout>


        <!-- Search Bar (rounded with search icon inside) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/periwinkle">

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search For User"
                android:drawableStart="@drawable/ic_magnifying_glass"
                android:drawablePadding="10dp"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:background="@android:color/transparent"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Location Requests Section (same as before) -->
        <TextView
            android:id="@+id/tv_location_requests_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Location Requests (201)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_location_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_location_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Unread"
                android:textColor="@color/dim_grey"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_location_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Read"
                android:textColor="@color/dim_grey"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Information Requests Section -->
        <TextView
            android:id="@+id/tv_info_requests_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Information Requests (88)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_info_requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_info_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Unread"
                android:textColor="@color/dim_grey"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_info_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Read"
                android:textColor="@color/dim_grey"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>