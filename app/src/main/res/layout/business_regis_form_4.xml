<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/business_regis_form_4"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_rectangle_periwinkle"
    android:elevation="10dp">

    <!-- Form -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <!-- Create Account Text -->
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="15dp"
            android:textAlignment="viewStart"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black"/>

        <!-- Page Count Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 of 4"
            android:textSize="10dp"
            android:textAlignment="center"
            android:layout_centerInParent="true"
            android:textColor="@color/black"/>

        <!-- User Type Text -->
        <TextView
            android:id="@+id/user_type_txt"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Business User"
            android:textSize="15dp"
            android:textAlignment="viewEnd"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black"/>

    </RelativeLayout>

    <!-- Separation Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/bg_pill_blue"/>

    <!-- Section Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Business Details Cont'd"
        android:textSize="15dp"
        android:textColor="@color/black"
        android:fontFamily="@font/roboto_medium"/>

    <LinearLayout
        android:id="@+id/reg_error_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_info"
            app:tint="@color/dark_amaranth"/>

        <TextView
            android:id="@+id/form4_reg_error_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textColor="@color/dark_amaranth"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Info Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_info"
            app:tint="@color/dim_grey"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Information provided will be verified."
            style="@style/info_txt_style"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical">

        <!-- Field Heading Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images of Business"
            android:textSize="15dp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_regular"/>

        <TextView
            android:id="@+id/img_upload_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textSize="12dp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_light"/>

    </LinearLayout>

    <!-- Image Upload Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        style="@style/file_upload_field_style">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/img_icon_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"/>

        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/upload_img_bttn"
            style="@style/file_upload_bttn_style"/>

    </LinearLayout>

    <!-- Info Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_info"
            app:tint="@color/dim_grey"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Allowed File Type: .JPEG, .PNG"
            style="@style/info_txt_style"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical">

        <!-- Field Heading Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Business License/Certificate/Permits"
            android:textSize="15dp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_regular"/>

        <TextView
            android:id="@+id/file_upload_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textSize="12dp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_light"/>

    </LinearLayout>

    <!-- File Upload Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        style="@style/file_upload_field_style">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/file_icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"/>

        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/upload_file_bttn"
            style="@style/file_upload_bttn_style"/>
    </LinearLayout>

    <!-- Info Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_info"
            app:tint="@color/dim_grey"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Allowed File Type: .PDF, .JPEG, .PNG"
            style="@style/info_txt_style"/>
    </LinearLayout>

    <!-- Form Page Control Buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <!-- Previous Button -->
        <LinearLayout
            android:id="@+id/prev_bttn3"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_rectangle_gold">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_caret_left"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREV"
                android:fontFamily="@font/roboto_extrabold"
                android:textColor="@color/black"
                android:textSize="16dp"/>
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/submit_bttn"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="center_horizontal"
            android:text="SUBMIT"
            style="@style/rectangle_bttn_gold"/>
    </RelativeLayout>

</LinearLayout>