<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true"
    tools:context=".ui.posts.PostFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ====== Posts Header Section ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Create Post Heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Posts"
                    style="@style/heading_txt_style"/>

                <!-- Submit Button -->
                <LinearLayout
                    android:id="@+id/prev_bttn2"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:background="@drawable/bg_rectangle_gold">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="8dp"
                        android:src="@drawable/ic_plus"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Create"
                        android:textSize="14sp"
                        style="@style/black_medium_txt_style"/>
                </LinearLayout>

            </RelativeLayout>


            <!-- Searchbar and dropdown-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Searchbar -->
                <LinearLayout
                    android:id="@+id/posts_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_rectangle_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <!-- Location Field -->
                    <EditText
                        android:id="@+id/posts_search_et"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search for Account or Location"
                        android:inputType="text"
                        android:singleLine="true"
                        style="@style/black_small_txt_style"/>

                    <!-- Search Button -->
                    <ImageView
                        android:id="@+id/posts_search_bttn"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ic_magnifying_glass"/>
                </LinearLayout>

                <!-- Search Results View -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/posts_search_results_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp">

                    <!-- Search Results Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Search Results"
                            android:textSize="13sp"
                            style="@style/black_medium_txt_style"/>

                        <!-- Filter icon -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_funnel"
                            android:contentDescription="Filter"
                            app:tint="@color/black" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="20dp"
                            android:layout_marginHorizontal="15dp"
                            android:background="@drawable/bg_rectangle_pale_slate"/>

                        <!-- Account Filter Option -->
                        <TextView
                            android:id="@+id/posts_search_filter_account"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="10dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_search_filter_inactive"
                            android:text="Account"
                            style="@style/black_small_txt_style"/>

                        <!-- Location Filter Option -->
                        <TextView
                            android:id="@+id/posts_search_filter_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="10dp"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_search_filter_inactive"
                            android:text="Location"
                            style="@style/black_small_txt_style"/>

                    </LinearLayout>

                    <ListView
                        android:id="@+id/posts_search_results_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@color/dim_grey"
                        android:dividerHeight="0.5dp"
                        android:layout_marginVertical="4dp"
                        style="@style/white_small_txt_style"/>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
        <!-- ====== Posts Header Section [END] ====== -->

        <!-- ====== Posts Section ====== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/posts_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="2dp"
            android:clipToPadding="false"/>

    </LinearLayout>

</FrameLayout>