<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/search_result_profile_pic"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_user_circle" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/search_result_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            style="@style/black_small_txt_style"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/search_result_verification_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginLeft="5dp"
            android:layout_toRightOf="@id/search_result_username"
            android:src="@drawable/ic_check_seal"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/search_result_user_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_username"
            android:text="General"
            style="@style/black_small_txt_style"
            android:textColor="@color/dim_grey" />
    </RelativeLayout>

</LinearLayout>