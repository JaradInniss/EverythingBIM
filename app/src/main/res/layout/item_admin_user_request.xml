<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="1dp">

    <!-- Unread/Read dot -->
    <View
        android:id="@+id/user_req_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dot_red"
        android:layout_marginEnd="10dp" />

    <!-- Request info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/user_req_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#201"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/user_req_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hackerton's Pub"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:fontFamily="@font/roboto_medium" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/user_req_submitted_by"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submitted By: User"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/user_req_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026/02/11"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:fontFamily="@font/roboto_medium" />

        </LinearLayout>

    </LinearLayout>

    <!-- View button -->
    <TextView
        android:id="@+id/user_req_view_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View"
        android:textColor="@color/true_cobalt"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>