<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_main"
        android:padding="7dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:cardCornerRadius="5dp">

            <ImageView
                android:id="@+id/map_location_related_post_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/map_location_related_post_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="14sp"
                style="@style/white_medium_txt_style"/>

            <ImageView
                android:id="@+id/post_verification_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginLeft="5dp"
                android:src="@drawable/ic_check_seal"/>

        </LinearLayout>

        <TextView
            android:id="@+id/map_location_related_post_caption"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:text="Caption"
            style="@style/white_small_txt_style"
            android:ellipsize="end"
            android:maxLines="2"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/likes_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/dark_amaranth"/>

            <TextView
                android:id="@+id/map_location_related_post_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/likes_icon"
                android:layout_marginLeft="4dp"
                android:text="45"
                style="@style/white_small_txt_style"/>

            <ImageView
                android:id="@+id/comments_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_toRightOf="@id/map_location_related_post_likes"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_comment"
                app:tint="@color/dim_grey"/>

            <TextView
                android:id="@+id/map_location_related_post_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/comments_icon"
                android:layout_marginLeft="4dp"
                android:text="45"
                style="@style/white_small_txt_style"/>

            <TextView
                android:id="@+id/map_location_related_post_upload_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="2 Wks Ago"
                style="@style/white_small_txt_style"/>

        </RelativeLayout>

    </LinearLayout>
    


</androidx.cardview.widget.CardView>