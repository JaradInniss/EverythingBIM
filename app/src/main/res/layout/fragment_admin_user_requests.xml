<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".AdminUserRequestsFragment">

    <!-- ══════════════════════════════════════
         HEADER
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/req_list_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_main"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_alignParentTop="true">

        <!-- Back + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/req_list_back_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_caret_left"
                android:background="@android:color/transparent"
                android:contentDescription="Go back"
                app:tint="@color/white"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- "General Users" pill on left -->
            <LinearLayout
                android:id="@+id/req_list_user_type_pill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_users_toggle_active"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/req_list_user_type_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_user"
                    android:contentDescription="@null"
                    android:layout_marginEnd="6dp"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/req_list_user_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Users"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto_medium" />

            </LinearLayout>

            <!-- Section title right of pill -->
            <TextView
                android:id="@+id/req_list_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Information Requests"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:fontFamily="@font/roboto_medium"
                android:gravity="end" />

        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_reports_search"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/req_list_search_et"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search ID, Username"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageView
                android:id="@+id/req_list_search_btn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_magnifying_glass"
                android:contentDescription="Search"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/black" />

        </LinearLayout>

        <!-- Filter pills row + count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- All / Unread / Read pills -->
            <TextView
                android:id="@+id/req_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_medium"
                android:background="@drawable/bg_search_filter_active"
                android:textColor="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/req_filter_unread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_medium"
                android:background="@drawable/bg_biz_unread_pill"
                android:textColor="@color/black"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/req_filter_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_medium"
                android:background="@drawable/bg_biz_read_pill"
                android:textColor="@color/black"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Total count -->
            <TextView
                android:id="@+id/req_list_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="88"
                android:textColor="@color/dim_grey"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_medium" />

        </LinearLayout>

        <!-- Unread / Read legend -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/bg_dot_red"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:textColor="@color/dim_grey"
                android:textSize="11sp"
                android:layout_marginEnd="12dp" />
            <View android:layout_width="10dp" android:layout_height="10dp"
                android:background="@drawable/bg_dot_grey"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read"
                android:textColor="@color/dim_grey"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════
         REQUEST LIST
    ══════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/req_list_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/req_list_header"
        android:padding="10dp"
        android:clipToPadding="false"
        android:background="@android:color/transparent" />

</RelativeLayout>