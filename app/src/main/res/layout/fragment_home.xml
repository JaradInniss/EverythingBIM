<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment"
    android:background="@drawable/bg_main"
    android:paddingTop="20dp"
    android:paddingHorizontal="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- History Button -->
        <LinearLayout
            android:id="@+id/home_history_bttn"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:background="@drawable/bg_rectangle_alice_blue">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clock_reverse"
                app:tint="@color/space_indigo" />
        </LinearLayout>

        <!-- Notifications Button -->
        <FrameLayout
            android:id="@+id/notification_bttn"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_rectangle_alice_blue">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="@color/space_indigo" />

            <TextView
                android:id="@+id/notification_badge_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/bg_notification_badge"
                android:minWidth="16dp"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:fontFamily="@font/roboto_bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Home Screen Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/notification_bttn"
            android:layout_marginTop="50dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Everything BIM"
                android:textSize="12sp"
                style="@style/subheading_txt_style"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Welcome,"
                android:textSize="32sp"
                android:textColor="@color/white"
                android:fontFamily="@font/roboto_extrabold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="36sp"
                android:textColor="@color/bright_gold"
                android:fontFamily="@font/pacifico"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Identify any place in BIM  instantly — just point your camera or pick from your gallery."
                android:textAlignment="center"
                android:textSize="15sp"
                style="@style/subheading_txt_style"/>

            <!-- Image Upload Container -->
            <RelativeLayout
                android:id="@+id/home_action_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/camera_opt_bttn"
                    android:layout_width="155dp"
                    android:layout_height="200dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/bg_rectangle_gold"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="360dp"
                        app:cardBackgroundColor="@color/old_gold">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_margin="8dp"
                            android:elevation="8dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/space_indigo" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="Take Photo"
                        android:textColor="@color/black"
                        style="@style/subheading_txt_style"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Use your camera"
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gallery_opt_bttn"
                    android:layout_width="155dp"
                    android:layout_height="200dp"
                    android:layout_toRightOf="@id/camera_opt_bttn"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_rectangle_blue"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="360dp"
                        app:cardBackgroundColor="@color/pale_blue">

                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_margin="8dp"
                            android:elevation="8dp"
                            android:src="@drawable/ic_images"
                            app:tint="@color/white" />

                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="Gallery"
                        android:textColor="@color/white"
                        style="@style/subheading_txt_style"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Choose from gallery"
                        android:textColor="@color/white"
                        android:textSize="12sp"/>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>


    </RelativeLayout>

</FrameLayout>
