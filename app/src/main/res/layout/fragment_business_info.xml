<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Address -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/address_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pin_area"
                app:tint="@color/dim_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_toRightOf="@id/address_icon"
                android:text="Address:"
                android:layout_marginStart="8dp"
                style="@style/grey_medium_txt_style" />

            <TextView
                android:id="@+id/biz_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/address_icon"
                android:layout_marginTop="5dp"
                android:text="Marvin Complex, St. Michael, Barbados"
                style="@style/black_medium_txt_style"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Phone -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/phone_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/dim_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_toRightOf="@id/phone_icon"
                android:text="Phone: "
                android:layout_marginStart="8dp"
                style="@style/grey_medium_txt_style" />

            <TextView
                android:id="@+id/biz_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/phone_icon"
                android:layout_marginTop="5dp"
                android:text="+1(246) 123-4567"
                style="@style/black_medium_txt_style"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Email -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/email_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_at_sign"
                app:tint="@color/dim_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_toRightOf="@id/email_icon"
                android:text="Email: "
                android:layout_marginStart="8dp"
                style="@style/grey_medium_txt_style" />

            <TextView
                android:id="@+id/biz_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/email_icon"
                android:layout_marginTop="5dp"
                android:text="chefette@gmail.com"
                style="@style/black_medium_txt_style"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Description -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/description_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_article"
                app:tint="@color/dim_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_toRightOf="@id/description_icon"
                android:text="Description: "
                android:layout_marginStart="8dp"
                style="@style/grey_medium_txt_style" />

            <TextView
                android:id="@+id/biz_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/description_icon"
                android:layout_marginTop="5dp"
                android:text="The Best Product in the 246"
                style="@style/black_medium_txt_style"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Images Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/images_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_images"
                app:tint="@color/dim_grey" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_toRightOf="@id/images_icon"
                android:text="Images: "
                android:layout_marginStart="8dp"
                style="@style/grey_medium_txt_style" />

            <!-- Location Images Field -->
            <HorizontalScrollView
                android:id="@+id/biz_images_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/images_icon"
                android:layout_marginTop="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_rectangle_alice_blue">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/biz_images_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp"/>

            </HorizontalScrollView>

        </RelativeLayout>



    </LinearLayout>
</androidx.core.widget.NestedScrollView>
