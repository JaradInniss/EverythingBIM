<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_dialog"
    android:padding="20dp">

    <!-- Warning icon — yellow -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_warning_circle"
        android:contentDescription="Warning"
        android:layout_marginBottom="10dp"
        app:tint="#ffde00" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reject This Request?"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Warning message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This Action Cannot Be Undone.\nPlease ensure this is done after completing the company's verification procedure."
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center"
        android:layout_marginBottom="14dp" />

    <!-- Rejection Reason label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rejection Reason:"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginBottom="6dp" />

    <!-- Rejection Reason text field -->
    <EditText
        android:id="@+id/dialog_reject_reason_et"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_admin_field"
        android:padding="10dp"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:fontFamily="@font/roboto_medium"
        android:hint="Enter reason..."
        android:layout_marginBottom="16dp" />

    <!-- Yes / No buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/dialog_reject_yes"
            android:layout_width="90dp"
            android:layout_height="42dp"
            android:text="Yes"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/bg_border_rectangle_celadon"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="14dp" />

        <Button
            android:id="@+id/dialog_reject_no"
            android:layout_width="90dp"
            android:layout_height="42dp"
            android:text="No"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/bg_border_rectangle_old_rose"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>