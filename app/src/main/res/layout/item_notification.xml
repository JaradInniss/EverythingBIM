<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:background="@drawable/bg_border_rectangle_periwinkle"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:id="@+id/notification_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_storefront"
            app:tint="@color/space_indigo" />

        <View
            android:id="@+id/notification_unread_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_red" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_title"
                style="@style/black_medium_txt_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Request Results"
                android:textColor="@color/space_indigo"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/notification_message"
                style="@style/black_small_txt_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The request you submitted has been reviewed"
                android:textColor="@color/space_indigo" />
        </LinearLayout>

        <ImageView
            android:id="@+id/navigate_to_content_bttn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_caret_right"
            app:tint="@color/space_indigo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notification_expanded_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/notification_status"
            style="@style/black_small_txt_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Status: In Review"
            android:textColor="@color/space_indigo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_detail"
            style="@style/black_small_txt_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Open this notification to see more information."
            android:textColor="@color/space_indigo" />

        <TextView
            android:id="@+id/notification_action_cta"
            style="@style/black_small_txt_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open details"
            android:textColor="@color/prussian_blue"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
