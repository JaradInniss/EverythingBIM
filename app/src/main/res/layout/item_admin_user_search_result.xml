<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:layout_marginBottom="6dp">

    <!-- Avatar circle -->
    <ImageView
        android:id="@+id/search_result_avata4"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_user_circle"
        android:background="@color/white"
        android:contentDescription="User avatar"
        android:scaleType="centerCrop"
        android:layout_marginEnd="10dp"
        app:tint="@color/true_cobalt" />

    <!-- Username -->
    <TextView
        android:id="@+id/search_result_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="HarryOsborne12"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:fontFamily="@font/roboto_medium" />

    <!-- Verified badge (for business users) -->
    <ImageView
        android:id="@+id/search_result_verified"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_check_circle"
        android:contentDescription="Verified"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:tint="@color/true_cobalt" />

    <!-- View button -->
    <TextView
        android:id="@+id/search_result_view_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View"
        android:textColor="@color/true_cobalt"
        android:textSize="13sp"
        android:fontFamily="@font/roboto_medium"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>