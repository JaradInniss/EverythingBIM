<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:gravity="center"
    tools:context=".Login">

    <!-- User Type Selection -->
    <LinearLayout
        android:id="@+id/user_type_selection"
        android:layout_width="220dp"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="70dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/pill_bg_grey"
        android:layout_above="@id/login_form"
        android:elevation="20dp">

        <ImageView
            android:id="@+id/user_type_business"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:paddingBottom="10dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/storefront"/>

        <ImageView
            android:id="@+id/user_type_general"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:paddingBottom="10dp"
            android:layout_marginLeft="20dp"
            android:background="@drawable/pill_bg_yllw"
            android:src="@drawable/user"/>

    </LinearLayout>

    <!-- Registration Form -->
    <LinearLayout
        android:id="@+id/login_form"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bttn_bg_grey"
        android:elevation="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="15dp"
                android:textAlignment="viewStart"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/user_type_txt"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="15dp"
                android:textAlignment="viewEnd"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/black"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/black"/>
        
        <EditText
            android:id="@+id/register_username_et"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:hint="Username"
            android:fontFamily="@font/roboto_regular"
            android:textSize="15dp"/>

        <EditText
            android:id="@+id/register_password_et"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:hint="Password"
            android:fontFamily="@font/roboto_regular"
            android:textSize="15dp"/>

        <EditText
            android:id="@+id/register_repassword_et"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:hint="Re-enter Password"
            android:fontFamily="@font/roboto_regular"
            android:textSize="15dp"/>

        <EditText
            android:id="@+id/register_email"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:hint="Email"
            android:fontFamily="@font/roboto_regular"
            android:textSize="15dp"/>

        <Button
            android:id="@+id/submit_bttn"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:text="SUBMIT"
            style="@style/bttn_style_yllw"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Already Have An Account?"
            android:fontFamily="@font/roboto_light"/>

        <TextView
            android:id="@+id/login_opt"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:textAlignment="center"
            android:text="Login"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/blue"/>
    </LinearLayout>

</RelativeLayout>