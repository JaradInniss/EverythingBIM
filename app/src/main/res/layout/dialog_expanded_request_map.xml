<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/expanded_request_map_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/prussian_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/expanded_request_map_close_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close map"
            android:src="@drawable/ic_caret_left"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Expanded Map"
            style="@style/white_medium_txt_style" />

        <Button
            android:id="@+id/expanded_request_map_use_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_rectangle_gold"
            android:paddingHorizontal="14dp"
            android:text="Use"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/expanded_request_map_hint_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/expanded_request_map_toolbar"
        android:background="@color/alice_blue"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/dim_grey"
        android:textSize="13sp" />

    <com.google.android.gms.maps.MapView
        android:id="@+id/expanded_request_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/expanded_request_map_hint_tv" />

</RelativeLayout>
