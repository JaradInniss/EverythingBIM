<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/business_regis_form_1"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_rectangle_periwinkle"
    android:elevation="10dp">

    <!-- Form -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <!-- Create Account Text -->
        <TextView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="15dp"
            android:textAlignment="viewStart"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black"/>

        <!-- Page Count Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 of 4"
            android:textSize="10dp"
            android:textAlignment="center"
            android:layout_centerInParent="true"
            android:textColor="@color/black"/>

        <!-- User Type Text -->
        <TextView
            android:id="@+id/user_type_txt"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Business User"
            android:textSize="15dp"
            android:textAlignment="viewEnd"
            android:letterSpacing="0.02"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/black"/>

    </RelativeLayout>

    <!-- Separator Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/bg_pill_blue" />

    <!-- Section Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Account Credentials"
        android:textSize="15dp"
        android:textColor="@color/black"
        android:fontFamily="@font/roboto_medium"/>

    <LinearLayout
        android:id="@+id/reg_error_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_info"
            app:tint="@color/dark_amaranth"/>

        <TextView
            android:id="@+id/form1_reg_error_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textColor="@color/dark_amaranth"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Username Field (ID: business_register_username_et) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_business_register_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Username"
        style="@style/auth_txtInputLayout_style">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/business_register_username_et"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:inputType="text"
            style="@style/txtInputEditText_style"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Email Field (ID: business_register_email_et) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_business_register_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Email"
        style="@style/auth_txtInputLayout_style">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/business_register_email_et"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:inputType="textEmailAddress"
            style="@style/txtInputEditText_style"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Field (ID: business_register_password_et) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_business_register_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Password"
        app:passwordToggleEnabled="true"
        style="@style/auth_txtInputLayout_style">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/business_register_password_et"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:inputType="textPassword"
            style="@style/txtInputEditText_style"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Re-enter Password Field (ID: business_register_repassword_et) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_business_register_repassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:hint="Re-enter Password"
        app:passwordToggleEnabled="true"
        style="@style/auth_txtInputLayout_style">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/business_register_repassword_et"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:inputType="textPassword"
            style="@style/txtInputEditText_style"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Next Button -->
    <LinearLayout
        android:id="@+id/next_bttn1"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_rectangle_gold">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT"
            android:fontFamily="@font/roboto_extrabold"
            android:textColor="@color/black"
            android:textSize="16dp"/>

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_caret_right"/>
    </LinearLayout>

    <!-- Already Have An Account? -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="Already Have An Account?"
        android:textColor="@color/dark"
        android:fontFamily="@font/roboto_medium"/>

    <!-- Login Option -->
    <TextView
        android:id="@+id/login_opt"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:textAlignment="center"
        android:text="Login"
        android:textSize="16sp"
        android:fontFamily="@font/roboto_bold"
        android:textColor="@color/persian_blue"/>

</LinearLayout>