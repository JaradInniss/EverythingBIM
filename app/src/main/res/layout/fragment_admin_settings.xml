<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".AdminSettingsFragment">

    <!-- ======================== HEADER (anchored at top) ======================== -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:background="@color/prussian_blue">

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/profile_pic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/butterfly"
            android:background="@drawable/circle_crop"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:layout_marginStart="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/adminText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:paddingLeft="18dp"/>

            <TextView
                android:id="@+id/admin_ID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#102MA21"
                android:textSize="10sp"
                android:textColor="@color/dim_grey"
                android:paddingTop="8dp"
                android:paddingLeft="18dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ======================== SCROLLABLE FORM (below header) ======================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ══════════════════════════════════════
                 SETTINGS CARD
            ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ── Card Header ─────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/icon_user_circle_gear"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/prussian_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User Profile Settings"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/roboto_medium" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_grey"
                        android:layout_marginBottom="16dp" />

                    <!-- ── Username Field ──────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_admin_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Username:"
                                android:textColor="@color/prussian_blue"
                                android:textSize="11sp"
                                android:fontFamily="@font/roboto_medium" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/admin_username_et"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="User"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:fontFamily="@font/roboto_medium"
                                android:background="@android:color/transparent"
                                android:padding="0dp"
                                android:focusable="false"
                                android:clickable="false" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/admin_edit_username_btn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/icon_edit"
                            android:background="@drawable/bg_admin_edit_btn"
                            android:contentDescription="Edit username"
                            android:padding="10dp"
                            app:tint="@color/white"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- ── Email Field ─────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_admin_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email:"
                                android:textColor="@color/dark"
                                android:textSize="11sp"
                                android:fontFamily="@font/roboto_medium" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/admin_email_et"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="anonymous@gmail.com"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:fontFamily="@font/roboto_medium"
                                android:background="@android:color/transparent"
                                android:inputType="textEmailAddress"
                                android:padding="0dp"
                                android:focusable="false"
                                android:clickable="false" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/admin_edit_email_btn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/icon_edit"
                            android:background="@drawable/bg_admin_edit_btn_grey"
                            android:contentDescription="Edit email"
                            android:padding="10dp"
                            app:tint="@color/dark"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- ── Password Field ──────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="40dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="8dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/password_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Password:"
                                android:textColor="@color/dark"
                                android:textSize="11sp"
                                android:fontFamily="@font/roboto_medium" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/admin_password_et"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="••••••••••••"
                                android:textColor="@color/black"
                                android:textSize="15sp"
                                android:fontFamily="@font/roboto_medium"
                                android:background="@android:color/transparent"
                                android:inputType="textPassword"
                                android:padding="0dp"
                                android:focusable="false"
                                android:clickable="false"
                                android:layout_below="@id/password_label" />

                            <ImageButton
                                android:id="@+id/admin_password_eye_btn"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_eye"
                                android:background="@android:color/transparent"
                                android:contentDescription="Toggle password"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:tint="@color/dark"
                                android:clickable="true"
                                android:focusable="true" />
                        </RelativeLayout>

                        <ImageButton
                            android:id="@+id/admin_edit_password_btn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/icon_edit"
                            android:background="@drawable/bg_admin_edit_btn_grey"
                            android:contentDescription="Edit password"
                            android:padding="10dp"
                            app:tint="@color/dark"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- ── Admin Role Field (read-only) ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_admin_field"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admin Role:"
                            android:textColor="@color/dark"
                            android:textSize="11sp"
                            android:fontFamily="@font/roboto_medium" />

                        <TextView
                            android:id="@+id/admin_role_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Super Admin"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/roboto_medium"
                            android:paddingTop="2dp" />
                    </LinearLayout>

                    <!-- Divider above Log Out -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_grey"
                        android:layout_marginBottom="16dp" />

                    <!-- ── Log Out Button ───────────── -->
                    <Button
                        android:id="@+id/admin_logout_btn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Log Out"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto_medium"
                        android:background="@drawable/bg_admin_logout_btn"
                        android:drawableStart="@drawable/icon_sign_out"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>