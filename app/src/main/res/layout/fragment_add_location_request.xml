<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.user.AddLocationRequestFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/add_locreq_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/dark"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_caret_left"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            app:tint="@color/white"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New Add Location Request"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/add_locreq_user_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#102MA21"
                android:textColor="@color/light_grey"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/add_locreq_toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/light_grey"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/add_locreq_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="6dp"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Form header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="10dp"
                        android:text="Complete The Form With The Required Information"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <!-- Search bar + dropdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:id="@+id/search_bar"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/bg_pill_alice_blue"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">
                            <EditText
                                android:id="@+id/search_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@null"
                                android:fontFamily="@font/roboto_medium"
                                android:hint="Location"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:imeOptions="actionSearch" />
                            <ImageView
                                android:id="@+id/search_bttn"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginRight="10dp"
                                android:src="@drawable/ic_magnifying_glass"
                                app:tint="@color/black" />
                        </LinearLayout>

                        <ListView
                            android:id="@+id/search_results_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:elevation="4dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Map -->
                    <com.google.android.gms.maps.MapView
                        android:id="@+id/viewlocreq_map"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_rectangle_pale_slate"
                        android:layout_marginBottom="16dp" />

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Name"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/location_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/light_grey"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        android:background="@drawable/bg_rectangle_pale_slate"
                        android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/location_name_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="12sp"
                            android:padding="10dp"
                            android:background="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Location Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Description"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/location_desc_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/light_grey"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        android:background="@drawable/bg_rectangle_pale_slate"
                        android:layout_marginBottom="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/location_desc_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="12sp"
                            android:padding="10dp"
                            android:background="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Place Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Place Type"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_rectangle_dim_grey"
                        android:layout_marginBottom="10dp">
                        <Spinner
                            android:id="@+id/place_type_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:paddingStart="10dp"
                            android:paddingEnd="36dp" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/icon_caret_down"
                            android:contentDescription="@null"
                            app:tint="@color/dark_grey" />
                    </RelativeLayout>

                    <!-- Reason For Request -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reason For Request"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rectangle_pale_slate"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Images of Location -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Images of Location"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="5dp"
                        android:background="@drawable/bg_rectangle_pale_slate">

                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:scrollbars="none">
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/img_icon_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="4dp" />
                        </HorizontalScrollView>
                        <ImageButton
                            android:id="@+id/upload_img_bttn"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:src="@drawable/ic_paperclip"
                            android:background="@drawable/bg_rectangle_pale_slate"/>
                    </LinearLayout>

                    <!-- Allowed types -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_info"
                            app:tint="@color/dim_grey"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Allowed: jpeg, png"
                            style="@style/info_txt_style" />
                    </LinearLayout>

                    <!-- Submit -->
                    <Button
                        android:id="@+id/submit_bttn"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:text="SUBMIT"
                        style="@style/rectangle_bttn_gold"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>