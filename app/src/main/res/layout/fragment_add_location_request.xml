<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.user.AddLocationRequestFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/add_locreq_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#272727"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_caret_left"
            android:background="@android:color/transparent"
            android:contentDescription="Go back"
            android:tint="@color/white"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New Add Location Request"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/add_locreq_user_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#102MA21"
                android:textColor="@color/light_grey"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable form content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/add_locreq_toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/light_grey"
            android:padding="10dp">

            <!-- Add Location Form -->
            <androidx.cardview.widget.CardView
                android:id="@+id/add_locreq_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="10dp"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Form header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:text="Complete The Form With The Required Information"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>

                    <!-- Searchbar and dropdown-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical">

                        <!-- Searchbar -->
                        <LinearLayout
                            android:id="@+id/search_bar"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/pill_bg_grey"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <!-- Location Field -->
                            <EditText
                                android:id="@+id/search_et"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:fontFamily="@font/roboto_medium"
                                android:hint="Location"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textSize="12dp"
                                android:textColor="@color/black"/>

                            <!-- Search Button -->
                            <ImageView
                                android:id="@+id/search_bttn"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginRight="10dp"
                                android:src="@drawable/icon_magnifying_glass"
                                app:tint="@color/black" />
                        </LinearLayout>

                        <ListView
                            android:id="@+id/search_results_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Map - Needs to Added  -->
                    <View
                        android:id="@+id/add_locreq_map"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_grey"
                        android:layout_marginBottom="16dp" />

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Name"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/location_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/light_grey"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        android:background="@drawable/bg_grey"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/location_name_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="12sp"
                            android:padding="10dp"
                            android:background="@android:color/transparent"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Location Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Description"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/location_desc_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/light_grey"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        android:background="@drawable/bg_grey"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/location_desc_et"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:inputType="textMultiLine"
                            android:gravity="top"
                            android:textSize="12sp"
                            android:padding="10dp"
                            android:background="@android:color/transparent"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Reason For Request -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reason For Request"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="5dp" />

                    <Spinner
                        android:id="@+id/reason_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_grey"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Images of Location -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Images of Location"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="5dp" />

                    <!-- Image Upload Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:padding="5dp"
                        android:background="@drawable/bg_grey">

                        <HorizontalScrollView
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:scrollbars="none">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/img_icon_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="4dp"/>

                        </HorizontalScrollView>

                        <ImageButton
                            android:id="@+id/upload_img_bttn"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:src="@drawable/icon_paperclip"
                            android:background="@drawable/bg_grey"/>
                    </LinearLayout>

                    <!-- Info Text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/icon_info"
                            app:tint="@color/dark_grey"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="Allowed File Type: .PDF, .JPEG, .PNG"
                            style="@style/info_txt_style"/>
                    </LinearLayout>

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/submit_bttn"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="SUBMIT"
                        style="@style/bttn_style_yllw"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>