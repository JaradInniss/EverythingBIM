<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".AdminHomeFragment">

    <!-- Header Section with Profile, Welcome Text, and Notification -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_main"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Profile Icon -->
        <ImageView
            android:id="@+id/img_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_user_circle"
            android:contentDescription="Profile"
            app:tint="@color/white" />

        <!-- Welcome Back and Admin Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_welcome_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textColor="@color/light_grey"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Notification Button -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btn_notification"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_border_rectangle_alice_blue"
                android:src="@drawable/ic_bell"
                android:contentDescription="Notifications"
                android:padding="8dp"
                app:tint="@color/space_indigo" />

            <TextView
                android:id="@+id/tv_notification_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_dot_red"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Scrollable Content Section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/white">

            <!-- Unread Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unread Requests"
                android:textColor="@color/prussian_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Horizontal 4 Cards Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- Card 1: Business -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_business"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@color/persian_blue">

                            <ImageView
                                android:id="@+id/icon_business"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_storefront"
                                android:contentDescription="Business icon"
                                app:tint="@color/white" />

                        <TextView
                            android:id="@+id/title_business"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Business"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_business_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="02"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_business_count_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1"
                            android:textColor="@color/green"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                        </LinearLayout>

                        <!-- Unread dot indicator -->
                        <View
                            android:id="@+id/dot_business"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_dot_red"
                            android:visibility="visible" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Card 2: Information -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@color/periwinkle">

                            <ImageView
                                android:id="@+id/icon_info"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_info"
                                android:contentDescription="Info icon"
                                app:tint="@color/black" />

                        <TextView
                            android:id="@+id/title_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Information"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_info_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="06"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_info_count_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+3"
                            android:textColor="@color/green"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                        </LinearLayout>

                        <!-- Unread dot indicator -->
                        <View
                            android:id="@+id/dot_info"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_dot_red"
                            android:visibility="visible" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Card 3: Location -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@color/periwinkle">

                            <ImageView
                                android:id="@+id/icon_location"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_pin_area"
                                android:contentDescription="Location icon"
                                app:tint="@color/black" />

                        <TextView
                            android:id="@+id/title_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_location_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tv_location_count_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+4"
                            android:textColor="@color/green"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                        </LinearLayout>

                        <!-- Unread dot indicator -->
                        <View
                            android:id="@+id/dot_location"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_dot_red"
                            android:visibility="visible" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Card 4: Reports -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reports"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="@color/bright_gold">

                            <ImageView
                                android:id="@+id/icon_reports"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_flag_banner"
                                android:contentDescription="Reports icon"
                                app:tint="@color/black" />

                        <TextView
                            android:id="@+id/title_reports"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reports"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_reports_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_reports_count_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1"
                            android:textColor="@color/dark_amaranth"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                        </LinearLayout>

                        <!-- Unread dot indicator -->
                        <View
                            android:id="@+id/dot_reports"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_dot_red"
                            android:visibility="visible" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_dataset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:background="@color/alice_blue">

                        <ImageView
                            android:id="@+id/icon_dataset"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_images"
                            android:contentDescription="Dataset submissions icon"
                            app:tint="@color/prussian_blue" />

                        <TextView
                            android:id="@+id/title_dataset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dataset Submissions"
                            android:textColor="@color/prussian_blue"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_dataset_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="@color/prussian_blue"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tv_dataset_count_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0"
                            android:textColor="@color/green"
                            android:gravity="center"
                            android:layout_marginTop="5dp"/>

                    </LinearLayout>

                    <View
                        android:id="@+id/dot_dataset"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_dot_red"
                        android:visibility="visible" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- Request Volume Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_request_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/periwinkle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header: Title and Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Request Volume"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/prussian_blue"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7 days"
                            android:textSize="12sp"
                            android:textColor="@color/dim_grey"/>

                        <TextView
                            android:id="@+id/tv_request_volume_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - 143"
                            android:textSize="12sp"
                            android:textColor="@color/prussian_blue"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_request_volume_incremental"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" +12"
                            android:textSize="12sp"
                            android:textColor="@color/green"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"/>

                    </LinearLayout>

                    <!-- Bar Chart -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom|center_horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Monday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_mon_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_mon"
                                android:layout_width="24dp"
                                android:layout_height="60dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mon"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Tuesday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_tue_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="22"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_tue"
                                android:layout_width="24dp"
                                android:layout_height="88dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tue"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Wednesday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_wed_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_wed"
                                android:layout_width="24dp"
                                android:layout_height="72dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wed"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Thursday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_thu_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="25"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_thu"
                                android:layout_width="24dp"
                                android:layout_height="100dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thu"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Friday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_fri_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_fri"
                                android:layout_width="24dp"
                                android:layout_height="120dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fri"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Saturday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_sat_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"/>

                            <View
                                android:id="@+id/bar_sat"
                                android:layout_width="24dp"
                                android:layout_height="80dp"
                                android:background="@color/true_cobalt"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sat"
                                android:textSize="10sp"
                                android:textColor="@color/dim_grey"
                                android:gravity="center"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Sunday Bar -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">

                            <TextView
                                android:id="@+id/tv_sun_value"
                                android:layout_width="wrap_content"
