<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="10dp"
    android:background="@drawable/bg_border_rectangle_white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/map_location_related_review_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Username"
        android:textSize="14sp"
        style="@style/black_medium_txt_style"/>

    <TextView
        android:id="@+id/map_location_related_review_body"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="2dp"
        android:text="Review Body"
        style="@style/black_small_txt_style"
        android:ellipsize="end"
        android:maxLines="4"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rating_star_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_star_fill"
            app:tint="@color/bright_gold"/>

        <TextView
            android:id="@+id/map_location_related_review_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/rating_star_icon"
            android:layout_marginLeft="4dp"
            android:text="4.5"
            style="@style/grey_small_txt_style"/>

        <ImageView
            android:id="@+id/comments_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_toRightOf="@id/map_location_related_review_rating"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_comment"
            app:tint="@color/dim_grey"/>

        <TextView
            android:id="@+id/map_location_related_review_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/comments_icon"
            android:layout_marginLeft="4dp"
            android:text="4"
            style="@style/grey_small_txt_style"/>

        <TextView
            android:id="@+id/map_location_related_review_upload_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="2 Wks Ago"
            style="@style/grey_small_txt_style"/>

    </RelativeLayout>

</LinearLayout>