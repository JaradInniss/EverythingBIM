<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rectangle_alice_blue"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/route_directions_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Directions"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/roboto_bold" />

        <TextView
            android:id="@+id/route_directions_close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_border_rectangle_gold"
            android:gravity="center"
            android:text="X"
            android:textColor="@color/prussian_blue"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/route_directions_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:fontFamily="@font/roboto_regular" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/route_directions_recycler"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
