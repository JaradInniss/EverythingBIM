<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/space_indigo"
        android:padding="10dp">

        <!-- Profile Picture -->
        <androidx.cardview.widget.CardView
            android:id="@+id/comment_profile_pic_card"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardCornerRadius="16dp"
            android:layout_marginRight="8dp"
            android:layout_alignParentStart="true">

            <ImageView
                android:id="@+id/comment_author_profile_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_user_circle"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <!-- Right side buttons aligned to top -->
        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/comment_profile_pic_card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Reply Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/reply_bttn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:cardCornerRadius="4dp"
                android:layout_marginRight="8dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reply"
                    app:tint="@color/space_indigo" />

            </androidx.cardview.widget.CardView>

            <!-- Delete Button (Admin only - hidden by default) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/comment_delete_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:cardCornerRadius="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/space_indigo">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/white" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/comment_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/comment_profile_pic_card"
            android:layout_marginStart="8dp"
            android:layout_toLeftOf="@id/button_container"
            android:text="Username"
            android:textSize="14sp"
            style="@style/white_small_txt_style"
            android:fontFamily="@font/roboto_medium"/>

        <!-- Reply destination and date wrapper -->
        <LinearLayout
            android:id="@+id/date_reply_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/comment_profile_pic_card"
            android:layout_below="@id/comment_username"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_toLeftOf="@id/button_container"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Reply destination -->
            <TextView
                android:id="@+id/comment_replying_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Re: Other User"
                style="@style/white_small_txt_style"
                android:visibility="gone"/>

            <!-- Upload Date -->
            <TextView
                android:id="@+id/comment_upload_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2026/01/01"
                style="@style/white_small_txt_style"/>

        </LinearLayout>

        <!-- Comment Body -->
        <TextView
            android:id="@+id/comment_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/comment_profile_pic_card"
            android:layout_below="@id/date_reply_container"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginRight="8dp"
            android:text="Comment body"
            style="@style/white_small_txt_style"/>

        <!-- Comment Replies Button & Count -->
        <LinearLayout
            android:id="@+id/comment_replies"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:layout_below="@id/comment_body"
            android:layout_marginTop="8dp"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="5dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_reply"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/comment_reply_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="10"
                style="@style/white_small_txt_style"/>

        </LinearLayout>

        <!-- Separator -->
        <View
            android:id="@+id/comment_reply_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/comment_replies"
            android:layout_marginTop="8dp"
            android:background="@color/white"/>

        <!-- Nested Replies RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/replies_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/comment_reply_separator"
            android:layout_marginTop="5dp"
            android:layout_marginStart="8dp">
        </androidx.recyclerview.widget.RecyclerView>

    </RelativeLayout>

</androidx.cardview.widget.CardView>