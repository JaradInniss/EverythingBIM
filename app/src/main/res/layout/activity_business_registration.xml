<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:gravity="center_horizontal"
    android:padding="10dp"
    tools:context=".ui.login.Login">

    <ScrollView
        android:id="@+id/business_registration_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/everything_bim_icon" />

                <TextView
                    android:id="@+id/title_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/logo"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="@font/pacifico"
                    android:text="Everything BIM"
                    android:textColor="@color/white"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/login_form_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/logo_container"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/user_type_selection"
                    android:layout_width="220dp"
                    android:layout_height="50dp"
                    android:layout_above="@id/reg_form_viewflipper"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_rectangle_periwinkle"
                    android:elevation="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <LinearLayout
                        android:id="@+id/general_user_container"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/general_user_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user"
                            app:tint="@color/dark" />

                        <TextView
                            android:id="@+id/general_user_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="General"
                            android:textColor="@color/dark" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="30dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="@drawable/bg_pill_blue" />

                    <LinearLayout
                        android:id="@+id/business_user_container"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_rectangle_blue"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/business_user_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_storefront"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/business_user_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Business"
                            android:textColor="@color/white" />

                    </LinearLayout>

                </LinearLayout>

                <ViewFlipper
                    android:id="@+id/reg_form_viewflipper"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@null">

                    <include
                        android:id="@+id/business_regis_form_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/business_regis_form_1" />

                    <include
                        android:id="@+id/business_regis_form_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/business_regis_form_2" />

                    <include
                        android:id="@+id/business_regis_form_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/business_regis_form_3" />

                    <include
                        android:id="@+id/business_regis_form_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/business_regis_form_4" />
                </ViewFlipper>

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <include
        android:id="@+id/scroll_hint_overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        layout="@layout/view_scroll_hint_overlay" />

</RelativeLayout>
