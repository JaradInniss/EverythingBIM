<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_user_profile_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.posts.ViewUserProfileActivity"
    android:background="@color/prussian_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- Dashboard Header -->
        <RelativeLayout
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_main"
            android:gravity="center_vertical"
            android:padding="8dp">

            <!-- Return Button -->
            <ImageView
                android:id="@+id/return_bttn"
                android:layout_width="20dp"
                android:layout_height="26dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/ic_caret_left"
                app:tint="@color/white"/>

            <!-- Report Account Button -->
            <ImageView
                android:id="@+id/report_account_bttn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_flag_banner"
                app:tint="@color/white"/>

            <!-- Profile Picture -->
            <ImageView
                android:id="@+id/viewprofile_profile_pic"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_below="@id/return_bttn"
                android:src="@drawable/ic_user_circle"
                android:contentDescription="@null"
                app:tint="@color/light_grey" />

            <!-- Business Tag -->
            <TextView
                android:id="@+id/viewprofile_business_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/report_account_bttn"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_alice_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Business"
                android:visibility="gone"
                style="@style/black_small_txt_style"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="vertical"
                android:layout_below="@id/return_bttn"
                android:layout_toRightOf="@id/viewprofile_profile_pic"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/viewprofile_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/viewprofile_verification_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="8dp"
                    android:layout_toRightOf="@id/viewprofile_username"
                    android:src="@drawable/ic_check_seal"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/viewprofile_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/viewprofile_username"
                    android:text="#102MA21"
                    android:textColor="@color/light_grey"
                    android:textSize="13sp" />

            </RelativeLayout>

            <TextView
                android:id="@+id/viewprofile_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/viewprofile_profile_pic"
                android:layout_marginVertical="5dp"
                android:layout_marginHorizontal="5dp"
                android:text="Many a fine words... :D"
                android:textColor="@color/light_grey"
                android:textSize="14sp" />

            <!-- Tab Bar (Displayed for Business Accounts Only) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/viewprofile_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/viewprofile_bio"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/gold"
                app:tabSelectedTextColor="@color/white"
                app:tabTextColor="@color/light_grey"
                app:tabTextAppearance="@style/white_medium_txt_style"
                app:tabIndicatorHeight="2dp"
                app:tabMode="fixed"
                android:visibility="gone">
            </com.google.android.material.tabs.TabLayout>

        </RelativeLayout>

        <!-- Tab Content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewprofile_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">
        </androidx.viewpager2.widget.ViewPager2>

    </LinearLayout>

</RelativeLayout>
