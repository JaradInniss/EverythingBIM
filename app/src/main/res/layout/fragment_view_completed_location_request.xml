<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_completed_location_req"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.user.ViewCompletedLocationRequestFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/viewlocreq_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#272727"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icon_caret_left"
            android:background="@android:color/transparent"
            android:contentDescription="Go Back"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Add Location Request"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viewlocreq_user_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User #102MA21"
                android:textColor="@color/light_grey"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/viewlocreq_toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/viewlocreq_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Request number + Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <!-- Left: Request number + date -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/request_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Request #3001"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/submission_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Submitted: 2026/02/11"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                        <!-- Right: Status label + value + icon -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Status:"
                                    android:textColor="@color/grey"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/status_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Accepted"
                                    android:textColor="@color/green"
                                    android:textSize="12sp"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/status_icon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/check_circle"
                                android:contentDescription="Status Icon" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"
                        android:layout_marginBottom="4dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"/>

                    <!-- Map placeholder -->
                    <View
                        android:id="@+id/viewlocreq_map"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@color/light_grey"
                        android:layout_marginBottom="16dp" />

                    <!-- Location Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Name"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/viewlocreq_name_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        android:background="@drawable/bg_rounded"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/viewlocreq_name_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:focusable="false"
                            android:clickable="false"
                            android:text="Hackerton's Pub"
                            android:background="@android:color/transparent"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Location Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location Description"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/viewlocreq_desc_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        android:background="@drawable/bg_rounded"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/viewlocreq_desc_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:gravity="top"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:focusable="false"
                            android:clickable="false"
                            android:text="Hackerton's Pub is a newly opened pub with authentic local brews"
                            android:background="@android:color/transparent"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Reason For Request -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reason For Request"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/viewlocreq_reason_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        android:background="@drawable/bg_rounded"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/viewlocreq_reason_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:gravity="top"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:focusable="false"
                            android:clickable="false"
                            android:text="New Business/Store/Restaurant/Place of Interest"
                            android:background="@android:color/transparent"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Images of Location -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Images of Location"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rounded"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/viewlocreq_image_container"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:orientation="horizontal"
                            android:padding="4dp"
                            android:gravity="center_vertical" />

                    </HorizontalScrollView>
                    <!-- Divider above status details -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_grey"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Accepted details - shown when status is Accepted -->
                    <LinearLayout
                        android:id="@+id/viewlocreq_accepted_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/viewlocreq_accepted_date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accepted: 2026/02/11"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/viewlocreq_accepted_by_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accepted By: AdminUser1"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Rejected details - shown when status is Rejected -->
                    <LinearLayout
                        android:id="@+id/viewlocreq_rejected_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/viewlocreq_rejected_date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rejected: 2026/02/15"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/viewlocreq_rejected_by_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rejected By: AdminUser1"
                            android:textColor="@color/black"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/viewlocreq_rejection_reason_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reason For Rejection: False Business Information Provided"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>